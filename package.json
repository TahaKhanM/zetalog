{
  "name": "zetalog",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r test && pnpm test:seed",
    "test:seed": "node --test supabase/scripts/generate-seed.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:release-tooling": "node --test scripts/*.test.mjs",
    "release:check-env": "node scripts/check-release-env.mjs",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "3.3.18"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
