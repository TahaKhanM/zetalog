{
  "name": "zetalog",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:release-tooling": "node --test scripts/*.test.mjs",
    "release:check-env": "node scripts/check-release-env.mjs",
    "release:check-public": "node scripts/inspect-extension-zip.mjs apps/web/public/zetalog-chrome-1.0.0-secure.zip",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "3.3.18"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
